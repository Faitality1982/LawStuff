{
  "name": "zimmer-stemwave-survey",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous patient interest and price-sensitivity survey for Zimmer Chiropractic Stem Wave therapy",
  "type": "module",
  "scripts": {
    "test": "node tools/test_api.mjs",
    "dev": "wrangler pages dev public --d1=DB=stemwave-survey --local",
    "db:init:local": "wrangler d1 execute stemwave-survey --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute stemwave-survey --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy public --project-name=zimmer-stemwave-survey",
    "tail": "wrangler pages deployment tail --project-name=zimmer-stemwave-survey"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
